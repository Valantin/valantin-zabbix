  "name": "valantin-zabbix",
  "version": "0.0.1",
  "summary": " A openvox module for zabbix",
  "source": "https://github.com/valantin/valantin-zabbix",
  "dependencies": [
    {
      "name": "puppetlabs-stdlib",
      "version_requirement": ">= 4.25.0 < 11.0.0"
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.19.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
